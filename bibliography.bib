@article{burmanMeaningChangeMistakenMirror2022,
  title = {Meaning-{{Change Through}} the {{Mistaken Mirror}}: {{On}} the {{Indeterminacy}} of “{{Wundt}}” and “{{Piaget}}” in {{Translation}}},
  shorttitle = {Meaning-{{Change Through}} the {{Mistaken Mirror}}},
  author = {Burman, Jeremy Trevelyan},
  date = {2022-03-01},
  journaltitle = {Review of General Psychology},
  shortjournal = {Review of General Psychology},
  volume = {26},
  number = {1},
  pages = {22--48},
  publisher = {SAGE Publications Inc},
  issn = {1089-2680},
  doi = {10.1177/10892680211017521},
  url = {https://doi.org/10.1177/10892680211017521},
  urldate = {2022-09-12},
  abstract = {What does a name mean in translation? Quine argued, famously, that the meaning of gavagai is indeterminate until you learn the language that uses that word to refer to its object. The case is similar with scientific texts, especially if they are older; historical. Because the meanings of terms can drift over time, so too can the meanings that inform experiments and theory. As can a life’s body of work and its contributions. Surely, these are also the meanings of a name; shortcuts to descriptions of the author who produced them, or of their thought (or maybe their collaborations). We are then led to wonder whether the names of scientists may also mean different things in different languages. Or even in the same language. This problem is examined here by leveraging the insights of historians of psychology who found that the meaning of “Wundt” changed in translation: his experimentalism was retained, and his Völkerpsychologie lost, so that what Wundt meant was altered even as his work—and his name—informed the disciplining of Modern Psychology as an experimental science. Those insights are then turned here into a general argument, regarding meaning-change in translation, but using a quantitative examination of the translations of Piaget’s books from French into English and German. It is therefore Piaget who has the focus here, evidentially, but the goal is broader: understanding and theorizing “the mistaken mirror” that reflects only what you can think to see (with implications for replication and institutional memory).},
  langid = {english},
  keywords = {critical digital history of psychology,indigenization,integrated history and philosophy of science (iHPS),meaning-change,Piaget,translation},
  file = {C:\Users\m.batsching\Dropbox\zotero\Philosophy\Burman - 2022 - Meaning-Change Through the Mistaken Mirror On the.pdf}
}

