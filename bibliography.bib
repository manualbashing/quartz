@article{stanfordBuddhismAnimismPsychometric2019,
  title = {Beyond {{Buddhism}} and Animism: {{A}} Psychometric Test of the Structure of {{Burmese Theravada Buddhism}}},
  shorttitle = {Beyond {{Buddhism}} and Animism},
  author = {Stanford, Mark and Jong, Jonathan},
  date = {2019-12-17},
  journaltitle = {PLOS ONE},
  shortjournal = {PLOS ONE},
  volume = {14},
  number = {12},
  pages = {e0226414},
  publisher = {Public Library of Science},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0226414},
  url = {https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0226414},
  urldate = {2022-05-19},
  abstract = {Anthropologists and religious scholars have long debated the relationship between doctrinal Theravada Buddhism, so-called ‘animism’, and other folk practices in southeast Asian societies. A variety of models of this relationship have been proposed on the basis of ethnographic evidence. We provide the first psychometric and quantitative evaluation of these competing models, using a new scale developed for this purpose, the Burmese Buddhist Religiosity Scale. Having tested existing hypotheses in our first study (n = 2285) we formulated an alternative model, which was then tested in our second study (n = 3377). We argue that this model provides support for a two-dimensional distinction between great and little traditions, shedding light on decades-old theoretical debates. Far from being in conflict, the transnational religious tradition of the literati and the variegated religious practices of locals appear to be reflected in two complementary dimensions of religiosity. This distinction has been heretofore neglected in psychometric research, but arguably merits attention beyond Buddhism, in the psychology of religion more generally. Our findings suggest that, insofar as research on religiosity relies on doctrinal pronouncements denigrating little traditions as mere superstition, it may be blinded to a crucial dimension of religious life.},
  langid = {english},
  keywords = {Anthropology,Buddhism,Cross-cultural studies,local tradition,Myanmar,Psychological attitudes,Psychology,Psychometrics},
  file = {C\:\\Users\\m.batsching\\Dropbox\\zotero\\Buddhism\\Stanford and Jong - 2019 - Beyond Buddhism and animism A psychometric test o.pdf;C\:\\Users\\m.batsching\\Zotero\\storage\\TEKQW667\\article.html}
}

