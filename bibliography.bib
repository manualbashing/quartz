@article{petroniImprovingWikipediaVerifiability2023,
  title = {Improving {{Wikipedia}} Verifiability with {{AI}}},
  author = {Petroni, Fabio and Broscheit, Samuel and Piktus, Aleksandra and Lewis, Patrick and Izacard, Gautier and Hosseini, Lucas and Dwivedi-Yu, Jane and Lomeli, Maria and Schick, Timo and Bevilacqua, Michele and Mazaré, Pierre-Emmanuel and Joulin, Armand and Grave, Edouard and Riedel, Sebastian},
  date = {2023-10-19},
  journaltitle = {Nature Machine Intelligence},
  shortjournal = {Nat Mach Intell},
  volume = {5},
  number = {10},
  pages = {1142--1148},
  issn = {2522-5839},
  doi = {10.1038/s42256-023-00726-1},
  url = {https://www.nature.com/articles/s42256-023-00726-1},
  urldate = {2023-10-26},
  abstract = {Abstract             Verifiability is a core content policy of Wikipedia: claims need to be backed by citations. Maintaining and improving the quality of Wikipedia references is an important challenge and there is a pressing need for better tools to assist humans in this effort. We show that the process of improving references can be tackled with the help of artificial intelligence (AI) powered by an information retrieval system and a language model. This neural-network-based system, which we call SIDE, can identify Wikipedia citations that are unlikely to support their claims, and subsequently recommend better ones from the web. We train this model on existing Wikipedia references, therefore learning from the contributions and combined wisdom of thousands of Wikipedia editors. Using crowdsourcing, we observe that for the top 10\% most likely citations to be tagged as unverifiable by our system, humans prefer our system’s suggested alternatives compared with the originally cited reference 70\% of the time. To validate the applicability of our system, we built a demo to engage with the English-speaking Wikipedia community and find that SIDE’s first citation recommendation is preferred twice as often as the existing Wikipedia citation for the same top 10\% most likely unverifiable claims according to SIDE. Our results indicate that an AI-based system could be used, in tandem with humans, to improve the verifiability of Wikipedia.},
  langid = {english},
  file = {C:\Users\m.batsching\Zotero\storage\7CKYDQI7\Petroni et al. - 2023 - Improving Wikipedia verifiability with AI.pdf}
}

@article{pianciolaStalinistSpatialHierarchies2017,
  title = {Stalinist Spatial Hierarchies: Placing the {{Kazakhs}} and {{Kyrgyz}} in {{Soviet}} Economic Regionalization},
  shorttitle = {Stalinist Spatial Hierarchies},
  author = {Pianciola, Niccolò},
  date = {2017-01-02},
  journaltitle = {Central Asian Survey},
  volume = {36},
  number = {1},
  pages = {73--92},
  publisher = {Routledge},
  issn = {0263-4937},
  doi = {10.1080/02634937.2016.1221380},
  url = {https://doi.org/10.1080/02634937.2016.1221380},
  urldate = {2022-08-27},
  abstract = {Based on research in Russian and Kazakhstani archives, this article investigates connections between policies of peasant colonization, the sedentarization of pastoral nomadic peoples, and the economic regionalization of the USSR. After analysing debates from the 1920s, and limited sedentarization among Kazakhs and Kyrgyz during collectivization, the article argues that only by focusing on the economic regionalization of Central Asia, which placed the Kazakhs and the Kyrgyz in two different economic regions with dissimilar priorities, is it possible to explain the radically different outcomes of early Stalinist policies for similar pastoral peoples. The increased central control brought by the Stalinist Great Turn created a new spatial hierarchy directly connecting the bottom of the Soviet social and spatial pyramid, the livestock-breeding regions, to its top, the elite regime cities. The exclusion of the Kyrgyz ASSR from the massive livestock procurements that fed the Soviet political and industrial centres, and which led to the great famine in Kazakhstan (1931–33), can be explained by early Stalinist economic regionalization.},
  keywords = {colonization,Kazakhstan,Kyrgyzstan,pastoral nomads,regionalization,sedentarization,Soviet Union,Stalinism}
}

