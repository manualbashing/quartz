@incollection{aitzhanovaEMIHigherEducation2023,
  title = {{{EMI}} in Higher Education in {{Kazakhstan}}: {{Policy}} Supports and Challenges},
  shorttitle = {{{EMI}} in Higher Education in {{Kazakhstan}}},
  booktitle = {Policies, {{Politics}}, and {{Ideologies}} of {{English-Medium Instruction}} in {{Asian Universities}}},
  author = {Aitzhanova, Bridget Goodman , Kamila, Sulushash Kerimkulova},
  date = {2023},
  publisher = {Routledge},
  abstract = {Like other countries in Asia where English is a foreign language, Kazakhstan has developed an array of explicit policies and invested a considerable share of its financial resources to increase the use of EMI in higher education nationwide. Uniquely in Kazakhstan, these policies support EMI as part of master and doctoral programmes that conduct courses in three languages (Kazakh, Russian, and English). However, previous research has shown that top-down planning and investment of resources in EMI is not always sufficient to guarantee successful outcomes of full or partial EMI programmes. To further illuminate the challenges to EMI policy implementation, this chapter provides a thematic analysis of key policy documents that guide full or partial EMI at the national and institutional levels in Kazakhstan as influenced by international policies. This analysis is complemented with qualitative data from students, faculty, and administrators at six universities that have been implementing partial EMI. Data were interpreted through theories of language planning and policy. The findings show that while stakeholders are aligned with the goals of EMI and trilingual education in policy discourses, gaps in management and resources at different levels have a negative impact on pedagogy, potentially limiting the quality of EMI.},
  isbn = {978-1-00-317312-0},
  pagetotal = {18}
}

