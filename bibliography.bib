  journaltitle = {Ethnic and Racial Studies},
  volume = {22},
  number = {1},
  pages = {136--161},
  publisher = {Routledge},
  issn = {0141-9870},
  doi = {10.1080/014198799329620},
  url = {https://doi.org/10.1080/014198799329620},
  urldate = {2024-04-01},
  abstract = {Ecological mobilization frequently assumed ethnonationalist forms in the late Soviet period. In Kazakstan, however, popular grievances defined in ethnic terms, which manifested themselves as republic-wide ethnic protest in 1986 and appeared to pose a profound ethnonationalist challenge to the Soviet state in the early years of its perestroika, did not fuel the environmental movement in that republic. On the contrary, ecological protest adopted inter-nationalist, rather than ethno-nationalist, tropes in late Soviet Kazakstan. This article employs theoretical insights from the social movement literature to argue that the processes by which political contestation becomes framed (framing processes) account for the critical variation between instances of nationalist and non-nationalist environmental mobilization. Specifically, it contends that in Kazakstan- a setting characterized by a poverty of finances, organizational apparatuses, meeting space, and expertise- a domestic mobilizational frame was selected to resonate with a transnational master frame to tap essential financial and symbolic resources and generate widespread support for the anti-nuclear Nevada-Semipalatinsk Movement.},
  keywords = {Ecological Protest,Environmentalism,Ethnonationalism,Framing Processes,Social Movements,Soviet Kazakstan},
  file = {C:\Users\m.batsching\Dropbox\zotero\Research Fokus\Kazakhstan Mothertongue\2 Theoretical Background\3 Ethnolinguistic and civic nationalism\Schatz - 1999 - Notes on the 'Dog that didn't Bark' eco-internati.pdf}
