@article{yarcasLargeLanguageModels2022,
  title = {Do {{Large Language Models Understand Us}}?},
  author = {y Arcas, Blaise Agüera},
  options = {useprefix=true},
  date = {2022-05-01},
  journaltitle = {Daedalus},
  shortjournal = {Daedalus},
