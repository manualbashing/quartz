@article{boraEmotionalBehaviouralAdjustment2011,
  title = {Emotional and Behavioural Adjustment of Children Born Very Preterm at Early School Age},
  author = {Bora, Samudragupta and Pritchard, Verena E. and Moor, Stephanie and Austin, Nicola C. and Woodward, Lianne J.},
  date = {2011-12},
  journaltitle = {Journal of Paediatrics and Child Health},
  shortjournal = {J Paediatr Child Health},
  volume = {47},
  number = {12},
  eprint = {21679332},
  eprinttype = {pmid},
  pages = {863--869},
  issn = {1440-1754},
  doi = {10.1111/j.1440-1754.2011.02105.x},
  abstract = {AIMS: This paper describes the emotional and behavioural adjustment of children born very preterm (VPT) at early school age. Of particular interest was the degree of agreement between parents and teachers, and the extent of situational (parent or teacher) and pervasive (parent and teacher reported) adjustment problems. METHODS: A regionally representative cohort of 104 VPT (≤33 weeks gestation) and 108 full-term (FT) children born during 1998-2000 was studied prospectively to age six. At corrected age six, child emotional and behavioural adjustment was assessed using the parent and teacher rated strengths and difficulties questionnaires. RESULTS: According to parents, 6-year-old VPT children had odds of emotional, inattention/hyperactivity and peer problems that were 2.7 to 3.8 times higher than their FT peers. Similar difficulties were identified by teachers, but odds were much lower and nonsignificant (1.1-1.8). Agreement between parents and teachers was lower in the VPT than the FT group (mean alternative chance-correlated coefficient , AC(1) = 0.63 vs. 0.80). Examination of the extent of pervasively identified adjustment problems showed that VPT children had higher rates of emotional (6\% vs. 1\%) and inattention/hyperactivity problems (12\% vs. 6\%) than FT children. CONCLUSIONS: Early school age, VPT children are at increased risk of pervasive emotional problems and inattention/hyperactivity, although these risks are relatively modest. The use of multiple informants to assess VPT children's well-being is important to minimise the effects of report source bias and the over-identification of adjustment problems in children born VPT.},
  langid = {english},
  keywords = {{Adaptation, Psychological},{Infant, Newborn},{Infant, Very Low Birth Weight},Child,Child Behavior,Developmental Disabilities,Expressed Emotion,Female,Humans,Male,New Zealand,Observer Variation,Premature Birth,Prospective Studies,Surveys and Questionnaires}
}

