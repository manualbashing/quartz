@article{klierVomKollaborativenIntelligenzfaktor2024,
  title = {Vom kollaborativen Intelligenzfaktor},
  author = {Klier, Alexander},
  date = {2024},
  publisher = {Unpublished},
  doi = {10.13140/RG.2.2.13110.47685},
  url = {https://rgdoi.net/10.13140/RG.2.2.13110.47685},
  urldate = {2025-01-27},
  abstract = {Dieser Preprint ist eine Überarbeitung meines Blogeintrags gleichen Titels auf meiner Webseite. Der Blogbeitrag entstand gedanklich und schriftlich im Sommer 2021, also am Ende der Corona Pandemie mit den vielen Schließungen und vor allem dem abrupten Übergang zur oftmals reinen Onlinelehre, die mich sehr auf Trab gehalten hatte, weil ich meine eigenen Lehrveranstaltungen auch als reine "Onlinelehre" organisieren musste und keine meiner üblichen Blended-Learning Kurse machen konnte. Gekoppelt habe ich den Blogbeitrag damals an die sehr spannende und kontroverse Diskussion bezüglich einer zunehmenden Intelligenz ganzer Gesellschaften (Flynn Effekt). Genauer eigentlich an die feststellbaren Tatsache, dass diese gerade wieder abzunehmen scheint. Verknüpft habe ich das mit der Entstehungsgeschichte der Intelligenztests, also den politischen, gesellschaftlichen und wissenschaftlichen Hintergründen zum Testen von Intelligenz – und der entstandenen Definition bzw. was diese Testungen über uns Menschen als intelligente Wesen eigentlich nicht aussagen. Mit dem Blogbeitrag hatte ich ein Thema aufgegriffen und für mich persönlich vertieft, das mich in Bezug auf eine digitale Bildung, heute sage ich Bildung in einer Kultur der Digitalität (Stalder 2016) dazu, schon seit langem bewegt, nämlich das der geteilten Intentionalität (Tomasello 2020) bzw. der gemeinschaftlichen Intentionalität (Schmid 2012) vor allem in Bezug auf Lehren und Lernen. Zwischen dem Blogbeitrag und diesem Preprint liegen also knapp zweieinhalb Jahre, in denen sich für mich sowohl inhaltlich einiges näher herauskristallisiert hat als auch auf der gesellschaftlichen Ebene unglaublich viel ereignet (hat), insbesondere unter dem Stichwort einer künstlichen Intelligenz. Das war Grund genug für mich, den Beitrag in Form eines Preprints zur Verfügung zu stellen. Ich habe diesen Preprint dennoch weitgehend in der ursprünglichen Form und Argumentationsweise belassen, was die umfangreichen Fußnoten erklärt. Sie passten nicht zum Lesen eines Blogs. Obwohl ich den ursprünglichen Blogbeitrag selbst durchaus als Publikation verstehe, möchte ich mit diesem Preprint auf ResearchGate die Auseinandersetzung mit dem Thema (künstliche) Intelligenz zur Verfügung stellen. Zu diesem Zweck habe ich auch das Literaturverzeichnis entsprechend am Ende hinterlegt und dabei festgestellt, dass das durchaus noch einmal eine herausfordernde und zeitintensive eigene Aufgabe war. Dieser Preprint steht unter den Bedingungen der Creative Commons BY-SA. Er darf also unter gleichen Bedingungen und bei Namensnennung frei verwendet werden.},
  langid = {ngerman},
  keywords = {Artificial Intelligence},
  file = {C:\Users\m.batsching\Zotero\storage\HSAWWEBM\Klier - 2024 - Vom kollaborativen Intelligenzfaktor.pdf}
}

@incollection{knealeIndifferenceWouldBe2019,
  title = {“{{Indifference Would Be Such}} a {{Relief}}”: {{Race}} and {{Weird Geography}} in {{Victor LaValle}} and {{Matt Ruff}}’s {{Dialogues}} with {{H}}. {{P}}. {{Lovecraft}}},
  shorttitle = {“{{Indifference Would Be Such}} a {{Relief}}”},
  booktitle = {Spaces and {{Fictions}} of the {{Weird}} and the {{Fantastic}}: {{Ecologies}}, {{Geographies}}, {{Oddities}}},
  author = {Kneale, James},
  editor = {Greve, Julius and Zappe, Florian},
  date = {2019},
  pages = {93--109},
  publisher = {Springer International Publishing},
  location = {Cham},
  doi = {10.1007/978-3-030-28116-8_7},
  url = {https://doi.org/10.1007/978-3-030-28116-8_7},
  urldate = {2024-07-31},
  abstract = {James Kneale examines a subject that has become increasingly central to critical work on the weird: H. P. Lovecraft’s explicit racism. In recent years a number of Lovecraftian stories have entered into critical dialogues with Lovecraft, including Victor LaValle’s The Ballad of Black Tom and Matt Ruff’s Lovecraft Country. These novels illustrate the ways in which racism makes ordinary places weird or eerie, threatening the mobility and security of their African-American protagonists, deforming their experience of space and time. Ruff and Lavalle present us with the horrors of white America, forcing us to ask whether the cosmic indifference which is so central to Lovecraft’s work affects us equally. In doing so they offer us new insights into the intersections between geography, racism, and the weird.},
  isbn = {978-3-030-28116-8},
  langid = {english}
